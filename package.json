{
  "name": "hotel-lindoia-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "test:operations": "node tests/operations.test.mjs",
    "test:accounting": "node tests/accounting-export.test.mjs",
    "test:finance": "node tests/finance.test.mjs",
    "test:improvements": "node tests/improvements.test.mjs",
    "preview": "vite preview",
    "test:cleaning": "node tests/cleaning.test.cjs",
    "test:inventory": "node tests/inventory.test.mjs",
    "test:checkout": "node tests/checkout.test.mjs",
    "test:pocketbase-import": "node --test tests/pocketbase-import.test.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "test:cloudflare": "node --test tests/cloudflare.test.mjs",
    "deploy:workers": "npm run deploy:cloudflare",
    "build:cloudflare": "npm run build",
    "deploy:cloudflare": "npm run test:cloudflare && npm run build && wrangler deploy",
    "dev:cloudflare": "npm run build && wrangler dev",
    "test:checkout-client": "node --test tests/checkout-client.test.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pocketbase": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wrangler": "^4.156.2"
  }
}
