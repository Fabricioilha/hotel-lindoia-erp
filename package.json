{
  "name": "hotel-lindoia-erp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:netlify": "npx --yes netlify-cli dev",
    "deploy:netlify": "npx --yes netlify-cli deploy --prod",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "eslint .",
    "test:operations": "node tests/operations.test.mjs",
    "test:accounting": "node tests/accounting-export.test.mjs",
    "test:finance": "node tests/finance.test.mjs",
    "test:improvements": "node tests/improvements.test.mjs",
    "preview": "vite preview",
    "test:cleaning": "node tests/cleaning.test.cjs",
    "test:inventory": "node tests/inventory.test.mjs",
    "test:checkout": "node tests/checkout.test.mjs",
    "test:checkout-runtime": "node --test tests/checkout-runtime.test.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "overrides": {
    "jwks-rsa": {
      "jose": "^5.10.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
