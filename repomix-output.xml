.sales-extra-grid { display: grid; gap: 6px; }
.sales-extra-option { display: grid; grid-template-columns: minmax(0, 1fr) 100px; align-items: center; gap: 8px; padding: 7px 8px; border: 1px solid #e1e7ef; border-radius: 3px; }
.sales-extra-option > label:first-child { display: flex; align-items: center; gap: 7px; color: #3d526a; font-size: 0.5625rem; font-weight: 650; }
