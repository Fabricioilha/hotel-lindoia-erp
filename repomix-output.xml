}

.reservation-form-section .reservation-channel-field {
  margin: 0;
}

.reservation-form-section .reservation-channel-field legend {
  margin-bottom: 8px;
  color: #455b68;
  font-size: 0.625rem;
  font-weight: 700;
}

.reservation-channel-options label {
  min-height: 58px;
  padding: 10px 12px;
  border-color: #d5dfe0;
  border-radius: 4px;
}

.reservation-channel-options label.selected {
  border-color: #527f82;
  background: #eff6f4;
  box-shadow: inset 0 0 0 1px #527f82;
}

.reservation-channel-options span {
  color: #2e4655;
  font-size: 0.75rem;
}

.reservation-channel-options small {
  margin-top: 4px;
  font-size: 0.625rem;
}

.reservation-breakfast-option {
  min-height: 42px;
  margin: 0;
  padding: 0 12px;
  border: 1px solid #dbe4e2;
  border-radius: 4px;
  background: #f7faf9;
}

.reservation-breakfast-option input {
  width: 17px;
  height: 17px;
}

.reservation-extra-list {
  display: grid;
  gap: 7px;
}

.reservation-extra-option {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 130px;
  align-items: center;
  gap: 10px;
  padding: 9px 11px;
  border: 1px solid #dbe4e2;
  border-radius: 4px;
  background: #fbfcfc;
}

.reservation-extra-option > label:first-child {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #425762;
  font-size: 0.625rem;
  font-weight: 650;
}

.reservation-extra-option input[type="checkbox"] {
  width: 16px;
  height: 16px;
  accent-color: #467b83;
}

.reservation-extra-option .schedule-field {
  gap: 3px;
  font-size: 0.5rem;
}

.reservation-extra-option .schedule-field input {
  min-height: 33px;
  padding: 6px 8px;
  font-size: 0.625rem;
}

.reservation-total-row {
  display: flex;
