}

.sales-page * { box-sizing: border-box; }
.sales-header { display: flex; min-height: 68px; align-items: center; justify-content: space-between; gap: 16px; padding: 10px clamp(18px, 4vw, 54px); border-top: 4px solid var(--sales-red); border-bottom: 1px solid #cdd6e3; background: #fff; }
.sales-brand { display: flex; align-items: center; gap: 10px; color: inherit; text-decoration: none; }
.sales-brand-mark { display: grid; width: 36px; height: 36px; place-items: center; border: 1px solid #93a5bf; border-radius: 4px; color: var(--sales-blue); font-size: 0.6875rem; font-weight: 800; }
.sales-brand strong,
.sales-brand small { display: block; }
.sales-brand strong { color: var(--sales-blue); font-size: 0.8125rem; }
.sales-brand small { margin-top: 2px; color: #8794a8; font-size: 0.5rem; font-weight: 800; letter-spacing: 1px; }
.sales-header-links { display: flex; gap: 16px; }
.sales-header-links a { color: #476184; font-size: 0.6875rem; font-weight: 700; text-decoration: none; }
.sales-header-links a:hover { color: var(--sales-red); }

.sales-content { width: min(100%, 1440px); margin: 0 auto; padding: 33px clamp(18px, 4vw, 54px) 48px; }
.sales-title-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 15px; margin-bottom: 20px; }
.sales-eyebrow { margin: 0 0 6px; color: var(--sales-red); font-size: 0.5625rem; font-weight: 800; letter-spacing: 1.15px; }
.sales-eyebrow span { padding: 0 4px; color: #a8b3c2; }
.sales-title-row h1 { margin: 0; color: var(--sales-blue); font-size: 1.688rem; font-weight: 750; letter-spacing: 0; line-height: 1.2; }
.sales-title-row > div > p:last-child { margin-top: 6px; color: var(--sales-muted); font-size: 0.6875rem; }
.sales-operator { display: flex; align-items: center; gap: 6px; padding: 6px 9px; border: 1px solid #cdd6e3; border-radius: 3px; color: #8290a3; background: #fff; font-size: 0.5625rem; }
.sales-operator strong { color: #425a7b; }

.sales-layout { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(310px, .72fr); align-items: start; gap: 14px; }
.pending-minibar-panel { display: grid; gap: 10px; margin-top: 18px; padding: 14px; border-top: 1px solid #cdd6e3; background: #fff; }
.pending-minibar-panel h2 { margin: 0; color: #1c3147; font-size: 0.9375rem; }
.pending-minibar-panel p { margin: 4px 0 0; color: #6a7888; font-size: 0.6875rem; }
.pending-minibar-sale { display: grid; grid-template-columns: minmax(130px, 1fr) auto minmax(145px, 180px) auto; align-items: center; gap: 9px; padding-top: 10px; border-top: 1px solid #edf0f3; color: #394b5c; font-size: 0.6875rem; }
.pending-minibar-sale > strong { color: #1c3147; }
.pending-minibar-sale select { width: 100%; min-height: 34px; border: 1px solid #cfd8e1; border-radius: 3px; padding: 0 8px; background: #fff; }
.pending-minibar-sale button { min-height: 34px; border: 0; border-radius: 3px; padding: 0 10px; color: #fff; background: #315f87; cursor: pointer; font-weight: 700; }
.catalog-panel,
.sale-order { min-width: 0; border: 1px solid #cdd6e3; border-radius: 5px; background: #fff; }
.catalog-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 17px; border-bottom: 1px solid #e8edf3; }
.catalog-heading h2,
.order-heading h2 { margin: 0; color: var(--sales-blue); font-size: 0.875rem; font-weight: 750; letter-spacing: 0; }
.catalog-heading p { margin-top: 4px; color: #8591a3; font-size: 0.625rem; }
.catalog-search { flex: 0 1 230px; }
.catalog-search input,
