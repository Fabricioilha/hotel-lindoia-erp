.sales-product-price { margin-top: 6px; color: var(--sales-red); font-size: 0.875rem; font-weight: 800; }
.sales-product-no-price { margin-top: 6px; color: #a65461; font-size: 0.5625rem; }
.sales-add-button { display: flex; min-height: 30px; align-items: center; justify-content: space-between; gap: 6px; margin-top: auto; padding: 5px 8px; border: 1px solid #dce5f0; border-radius: 3px; color: #315f96; background: #f2f6fb; font-size: 0.5625rem; font-weight: 750; cursor: pointer; }
.sales-add-button:hover:not(:disabled) { border-color: #b7c9de; background: #e7eff8; }
.sales-add-button:disabled { color: #9aa5b3; background: #f4f5f7; cursor: not-allowed; }
.sales-add-button span { font-size: 1rem; line-height: 1; }
.sales-stock-notice { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 12px 13px 0; padding: 10px 11px; border: 1px solid #e9d7ae; border-radius: 3px; color: #785a24; background: #fff9e9; font-size: 0.625rem; }
.sales-stock-notice a,
.sales-restock-button { flex: 0 0 auto; color: #315f96; font-size: 0.5625rem; font-weight: 750; text-decoration: none; }
.sales-stock-notice a:hover,
.sales-restock-button:hover { color: var(--sales-red); }
.sales-restock-button { display: flex; min-height: 30px; align-items: center; justify-content: space-between; gap: 6px; margin-top: auto; padding: 5px 8px; border: 1px solid #dce5f0; border-radius: 3px; background: #f2f6fb; }

.sale-order { position: sticky; top: 14px; padding: 16px; }
.order-heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid #e8edf3; }
.order-heading .sales-eyebrow { margin-bottom: 4px; }
