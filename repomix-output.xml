.finance-page {
  --finance-ink: #172a46;
  --finance-muted: #556580;
  --finance-border: #cdd6e3;
  min-height: 100vh;
  color: var(--finance-ink);
  background: #e8edf4;
  font-family: "Avenir Next", "Segoe UI", sans-serif;
}

.finance-page * { box-sizing: border-box; }
.finance-header { display: flex; min-height: 72px; align-items: center; justify-content: space-between; gap: 24px; padding: 12px clamp(18px, 5vw, 72px); border-top: 4px solid #c52e43; color: #fff; background: #142b4d; }
.finance-brand { display: flex; align-items: center; gap: 11px; color: inherit; text-decoration: none; }
.finance-brand-mark { display: grid; width: 38px; height: 38px; place-items: center; border: 1px solid #7184a2; border-radius: 4px; font-size: 0.6875rem; font-weight: 800; }
.finance-brand strong, .finance-brand small { display: block; }
.finance-brand strong { font-size: 0.8125rem; }
.finance-brand small { margin-top: 3px; color: #aebcd0; font-size: 0.5625rem; font-weight: 700; letter-spacing: 1px; }
.finance-header nav { display: flex; align-items: center; gap: 7px; }
.finance-header nav a { padding: 9px 11px; border: 1px solid transparent; border-radius: 4px; color: #cbd6e4; font-size: 0.6875rem; font-weight: 700; text-decoration: none; }
.finance-header nav a:hover, .finance-header nav .finance-nav-active { border-color: #435a78; color: #fff; background: #203c60; }

.finance-content { width: min(100%, 1440px); margin: 0 auto; padding: 34px clamp(18px, 5vw, 72px) 45px; }
.finance-page-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: 23px; }
.finance-eyebrow { margin: 0 0 7px; color: #c52e43; font-size: 0.5625rem; font-weight: 800; letter-spacing: 1px; }
.finance-eyebrow span { padding: 0 4px; color: #a9b3c2; }
.finance-page-heading h1 { margin: 0; font-size: 1.688rem; font-weight: 760; line-height: 1.2; }
.finance-page-heading > div:first-child > p:last-child { margin-top: 7px; color: var(--finance-muted); font-size: 0.75rem; }
.finance-heading-actions { display: flex; align-items: flex-end; justify-content: flex-end; flex-wrap: wrap; gap: 8px; }
.finance-month { display: grid; gap: 4px; margin-right: 4px; }
.finance-month span, .finance-field > span { color: var(--finance-muted); font-size: 0.625rem; font-weight: 700; }
.finance-month input, .finance-field input, .finance-field select, .finance-field textarea { width: 100%; min-height: 38px; padding: 8px 10px; border: 1px solid #d6deea; border-radius: 4px; color: var(--finance-ink); background: #fff; font: inherit; font-size: 0.75rem; }
.finance-field textarea { resize: vertical; }
.finance-button { min-height: 37px; padding: 8px 11px; border: 1px solid transparent; border-radius: 4px; font: inherit; font-size: 0.6875rem; font-weight: 750; cursor: pointer; }
.finance-button:disabled { opacity: .6; cursor: wait; }
.finance-button-soft { border-color: #d8e0eb; color: #344b6a; background: #fff; }
