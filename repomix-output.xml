.sale-submit:disabled { border-color: #c3cad4; color: #fff; background: #aeb8c6; cursor: not-allowed; }
.sale-note { margin-top: 8px; color: #5a6a80; font-size: 0.5625rem; line-height: 1.5; text-align: center; }

.sales-empty { display: grid; min-height: 180px; align-content: center; justify-items: center; gap: 7px; padding: 24px; color: #7c899b; text-align: center; }
.sales-empty strong { color: #31445f; font-size: 0.75rem; }
.sales-empty p { max-width: 330px; font-size: 0.625rem; line-height: 1.55; }
.sales-outline-button { margin-top: 5px; padding: 7px 10px; border: 1px solid #cbd8e7; border-radius: 3px; color: #315f96; font-size: 0.625rem; font-weight: 750; text-decoration: none; }
.sales-alert,
