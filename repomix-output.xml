.order-empty { padding: 20px 5px; color: #8995a6; font-size: 0.625rem; text-align: center; }
.order-lines { display: grid; max-height: 260px; overflow-y: auto; }
.sales-extra-order-lines { border-top: 1px dashed #d8e1eb; }
.remove-extra-button { width: 26px; height: 26px; flex: 0 0 auto; border: 1px solid #ead5d8; border-radius: 3px; color: #a52c3b; background: #fff; font-size: 1.062rem; cursor: pointer; }
.remove-extra-button:hover { background: #fff2f3; }
.order-line { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 11px 0; border-bottom: 1px solid #edf0f4; }
.order-line-info { display: grid; min-width: 0; gap: 2px; }
.order-line-info strong { overflow: hidden; color: #293d5a; font-size: 0.625rem; text-overflow: ellipsis; white-space: nowrap; }
