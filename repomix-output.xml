  }
}
.attendant-add-form { display: flex; align-items: flex-end; gap: 10px; margin-bottom: 12px; }
.attendant-add-form .schedule-field { flex: 1; }
.attendant-manage-list { display: grid; gap: 8px; max-height: 320px; margin: 0 0 14px; padding: 0; overflow-y: auto; list-style: none; }
.attendant-manage-list li { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border: 1px solid #e3e9e8; border-radius: 7px; }
.attendant-manage-list li > span, .attendant-manage-list li > input { flex: 1; min-width: 0; }
.housekeeping-modal .reservation-modal-error { margin: 0 0 12px; padding: 10px 12px; border-radius: 6px; background: #fdeeee; color: #9b1c1c; font-size: 0.875rem; font-weight: 600; }
