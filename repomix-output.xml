@import "tailwindcss";

:root {
  --text: #46566e;
  --text-h: #172a46;
  --bg: #fff;
  --border: #cdd6e3;
  --code-bg: #f2f5fa;
  --accent: #c52e43;
  --accent-bg: rgba(197, 46, 67, 0.1);
  --accent-border: rgba(197, 46, 67, 0.45);
  --social-bg: rgba(235, 240, 247, 0.7);
  --shadow:
    rgba(0, 0, 0, 0.1) 0 10px 15px -3px, rgba(0, 0, 0, 0.05) 0 4px 6px -2px;

  --sans: system-ui, 'Segoe UI', Roboto, sans-serif;
  --heading: system-ui, 'Segoe UI', Roboto, sans-serif;
  --mono: ui-monospace, Consolas, monospace;

