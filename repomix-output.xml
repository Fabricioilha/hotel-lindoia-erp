.module-disabled { background: #f7f8fa; }
.module-disabled .module-copy strong,
.module-disabled .module-copy p { color: #8994a5; }
.module-lock { position: absolute; right: 14px; bottom: 11px; color: var(--brand-red); font-size: 0.5625rem; font-weight: 700; }

@media (max-width: 980px) {
  .dashboard-metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .module-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 620px) {
  .dashboard-header { min-height: 66px; padding: 10px 15px; }
  .dashboard-header-actions { gap: 9px; }
  .dashboard-profile { padding-right: 9px; }
  .dashboard-profile strong { max-width: 98px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dashboard-logout { font-size: 0.625rem; }
  .dashboard-content { padding: 26px 15px 40px; }
  .dashboard-welcome { align-items: stretch; flex-direction: column; gap: 15px; }
  .dashboard-welcome h1 { font-size: 1.562rem; }
  .dashboard-metrics { gap: 8px; margin-bottom: 29px; }
  .dashboard-metric { min-height: 111px; padding: 14px 12px; }
  .dashboard-metric strong { font-size: 1.438rem; }
  .module-grid { grid-template-columns: 1fr; }
}
.duty-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 18px; color: #556580; font-size: 0.8125rem; }
.duty-bar > span { font-weight: 700; }
.duty-bar small { color: #b22a3e; }
.duty-option { min-height: 32px; padding: 0 14px; border: 1px solid #b8c5d8; border-radius: 16px; color: #315f87; background: #fff; font: inherit; font-size: 0.8125rem; font-weight: 700; cursor: pointer; }
.duty-option:hover { background: #eef3fa; }
.duty-option.is-on { color: #fff; background: #315f87; border-color: #315f87; }
.duty-bar strong { color: #315f87; font-size: 0.875rem; }
