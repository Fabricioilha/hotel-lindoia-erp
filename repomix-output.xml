  .room-list-heading h2 {
    font-size: 1.125rem;
  }

  .housekeeping-form-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }

  .housekeeping-modal {
    padding: 18px;
  }

  .housekeeping-modal:not(.reservation-modal) {
