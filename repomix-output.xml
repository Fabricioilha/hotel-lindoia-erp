  display: flex;
  justify-content: space-between;
  gap: 8px;
  color: #4f5f76;
  font-size: 0.5625rem;
}

.attendant-log > div span:last-child {
  overflow: hidden;
  color: #344a63;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.housekeeping-modal {
  width: min(100%, 500px);
  max-height: min(90vh, 720px);
  border-color: #d7e0e2;
  box-shadow: 0 22px 64px rgb(13 30 42 / 25%);
}

.housekeeping-modal:not(.reservation-modal) > form {
  display: grid;
  gap: 14px;
  padding-bottom: 20px;
}

.housekeeping-modal .schedule-modal-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  margin: 0;
  padding: 19px 22px 15px;
  border-bottom: 1px solid #e3e9e8;
  background: #fff;
}

.housekeeping-modal .schedule-field {
  margin: 0 22px;
}

.housekeeping-modal .schedule-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 8px;
  margin: 0 22px;
  padding-top: 13px;
  border-top: 1px solid #e6eceb;
}

.housekeeping-modal .doors-cleaning-option {
  margin: 0 22px;
  padding: 12px;
  border-radius: 4px;
}

.housekeeping-modal .schedule-field input,
.housekeeping-modal .schedule-field select,
.housekeeping-modal .schedule-field textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 37px;
  padding: 8px 9px;
  border: 1px solid #d4dce7;
  border-radius: 3px;
  color: #243951;
  background: #fff;
  font: inherit;
  font-size: 0.75rem;
}

.housekeeping-modal .schedule-field textarea {
  resize: vertical;
}

.housekeeping-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.doors-cleaning-option {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  margin-top: 14px;
  padding: 12px;
  border: 1px solid #d8e6dc;
  border-radius: 3px;
  background: #f4faf6;
  cursor: pointer;
}

.doors-cleaning-option.is-due {
  border-color: #efd9b3;
  background: #fff9ed;
}

.doors-cleaning-option input {
  width: 16px;
  height: 16px;
  margin: 1px 0 0;
  accent-color: #315f87;
}

.doors-cleaning-option strong,
.doors-cleaning-option small {
  display: block;
}

.doors-cleaning-option strong {
  color: #334960;
  font-size: 0.75rem;
}

.doors-cleaning-option small {
  margin-top: 3px;
  color: #77869a;
  font-size: 0.625rem;
}

@media (max-width: 1100px) {
  .housekeeping-summary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 850px) {
  .housekeeping-workspace {
    grid-template-columns: minmax(0, 1fr);
  }

  .attendant-panel {
    position: static;
    grid-column: 1;
    grid-row: auto;
  }
}

@media (max-width: 600px) {
  .housekeeping-app.stock-app {
    grid-template-columns: 1fr;
  }

  .housekeeping-app .stock-sidebar {
    position: relative;
    min-height: auto;
    padding: 12px 14px;
  }

  .housekeeping-app .housekeeping-sidebar-header {
    padding: 0 4px 12px;
  }

  .housekeeping-app .sidebar-label,
  .housekeeping-app .sidebar-footer {
    display: none;
  }

  .housekeeping-app .stock-nav {
    display: flex;
    width: 100%;
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .housekeeping-app .stock-nav .nav-item {
    flex: 0 0 auto;
    min-height: 34px;
    padding: 6px 9px;
  }

  .housekeeping-app .housekeeping-nav-icon {
    display: none;
  }

  .housekeeping-app.is-sidebar-collapsed .housekeeping-sidebar-header {
    padding-bottom: 0;
  }

  .housekeeping-app.is-sidebar-collapsed .stock-nav {
    display: none;
  }

  .housekeeping-app .stock-topbar {
    min-height: 48px;
    padding: 0 14px;
  }

  .housekeeping-app .back-link {
    display: none;
  }

  .housekeeping-app .stock-content {
    padding: 22px 12px 32px;
  }

  .housekeeping-app .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .housekeeping-app .heading-actions,
  .housekeeping-app .heading-actions .button {
    width: 100%;
  }

  .housekeeping-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }

  .housekeeping-metric {
    min-height: 74px;
    padding: 11px 12px;
  }

  .housekeeping-metric p {
    font-size: 0.625rem;
  }

  .housekeeping-controls {
    align-items: stretch;
    flex-direction: column;
    padding: 12px;
  }

  .doors-interval-control {
