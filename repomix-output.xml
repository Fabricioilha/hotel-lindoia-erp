.clean-page { display: grid; gap: 18px; max-width: 1200px; margin: 0 auto; padding: 28px clamp(16px, 4vw, 48px) 60px; color: #172a46; font-family: "DM Sans", "Avenir Next", sans-serif; }
.clean-title { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; }
