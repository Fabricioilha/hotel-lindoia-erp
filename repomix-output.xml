}

.reservation-rotativo-checkout {
  display: grid;
  align-content: center;
  gap: 4px;
  min-height: 58px;
  padding: 8px 12px;
  border-left: 2px solid #c99043;
  color: #77858b;
  background: #fbf8f1;
  font-size: 0.625rem;
}

.reservation-rotativo-checkout strong {
  color: #334d5a;
  font-size: 0.75rem;
}

.reservation-rotativo-checkout small {
  color: #8a969a;
  font-size: 0.5625rem;
}

.checkout-remaining-row {
  border-color: #e2e8e7;
  background: #f8faf9;
}

.checkout-remaining-row strong {
  color: #455d62;
  font-size: 0.9375rem;
}

.reservation-admin-balance {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 7px 20px;
  color: #718087;
  font-size: 0.625rem;
}

.reservation-admin-balance strong {
  color: #314c56;
  font-variant-numeric: tabular-nums;
}

.reservation-form-notes {
  border-bottom: 0;
}

.reservation-form-notes .reservation-hint {
  margin: 0;
}

.reservation-modal-footer {
  display: flex;
  flex: 0 0 auto;
  justify-content: flex-end;
  gap: 9px;
  padding: 14px 26px;
  border-top: 1px solid #e3e9e8;
  background: #fff;
}

.reservation-modal-footer .button {
  min-height: 40px;
  padding: 9px 15px;
  border-radius: 4px;
  font-size: 0.6875rem;
  font-weight: 750;
}
.reservation-hint {
  margin-top: 12px;
  color: #5a6a80;
  font-size: 0.625rem;
  line-height: 1.5;
}

.reservation-payment-history {
  display: grid;
  gap: 5px;
  padding: 10px 12px;
  border-left: 2px solid #8ca8b7;
  background: #f4f7f7;
  color: #53627a;
  font-size: 0.6875rem;
}

.reservation-breakfast-option {
  display: flex;
  align-items: center;
  gap: 9px;
  margin-top: 12px;
  color: #364e5f;
  font-size: 0.75rem;
  font-weight: 600;
}

.reservation-breakfast-option input {
  width: 16px;
  height: 16px;
  accent-color: #315f87;
}

.reservation-audit {
  margin-top: 20px;
  padding-top: 12px;
  border-top: 1px solid #dfe6e8;
  color: #53627a;
  font-size: 0.6875rem;
}

.reservation-audit summary {
  cursor: pointer;
  font-weight: 700;
}

.reservation-audit ol {
  display: grid;
  gap: 8px;
  margin: 12px 0 0;
  padding: 0;
  list-style: none;
}

.reservation-audit li,
.reservation-audit li span {
  display: block;
}

.reservation-audit li span {
  margin-top: 3px;
  overflow-wrap: anywhere;
  color: #5a6a80;
}

@media (max-width: 1100px) {
  .reservation-summary {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .reservation-summary {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 7px;
  }

  .reservation-summary .housekeeping-metric {
    min-height: 78px;
    padding: 11px 12px;
  }

  .reservation-toolbar {
    align-items: stretch;
    flex-direction: column;
    padding: 11px;
  }

  .reservation-search {
    width: 100%;
  }

  .reservation-tabs {
    overflow-x: auto;
    flex-wrap: nowrap;
  }

  .reservation-tabs button {
    flex: 0 0 auto;
  }

  .reservation-empty {
    padding: 18px;
  }

  .reservation-modal {
    padding: 0;
  }
  .reservation-modal-heading,
  .reservation-form-section { padding-right: 18px; padding-left: 18px; }
  .reservation-modal-footer { padding-right: 18px; padding-left: 18px; }
}

@media (max-width: 520px) {
  .reservation-backdrop { place-items: end center; padding: 0; }
  .reservation-modal { width: 100%; max-height: 94dvh; border-radius: 7px 7px 0 0; }
  .reservation-form { max-height: 94dvh; }
  .reservation-modal-heading,
  .reservation-form-section { padding: 16px; }
  .reservation-modal-heading { padding-top: 17px; padding-bottom: 14px; }
  .reservation-modal-heading h2 { font-size: 1.188rem; }
  .reservation-form-section { gap: 12px; }
  .reservation-form-grid { grid-template-columns: minmax(0, 1fr); gap: 11px; }
  .reservation-field-wide { grid-column: auto; }
  .reservation-channel-options { grid-template-columns: minmax(0, 1fr); }
  .reservation-channel-options label { min-height: 50px; }
  .reservation-modal-footer { padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); }
  .reservation-modal-footer .button { flex: 1; }
}
