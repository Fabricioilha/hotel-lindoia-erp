.clean-done:disabled { opacity: .6; }
.clean-link { border: 0; color: #476184; background: none; font: inherit; font-size: 0.8125rem; font-weight: 700; text-decoration: underline; cursor: pointer; }

.clean-tasks { display: grid; gap: 10px; }
.clean-task { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 16px; border: 1px solid #e0a52e; border-left: 6px solid #e0a52e; border-radius: 8px; background: #fff9e8; }
.clean-task-room { display: block; font-size: 1.25rem; font-weight: 800; }
.clean-task small { color: #6b5320; }
.clean-task-actions { display: flex; align-items: center; gap: 14px; }
.clean-table { width: 100%; border-collapse: collapse; font-size: 0.875rem; }
.clean-table th, .clean-table td { padding: 8px 10px; border-bottom: 1px solid #e1e7ef; text-align: left; }
.clean-table th { color: #476184; font-size: 0.6875rem; text-transform: uppercase; }
.clean-manage { display: grid; gap: 8px; margin: 0; padding: 0; list-style: none; }
.clean-manage li { display: flex; align-items: center; justify-content: space-between; padding: 10px 12px; border: 1px solid #e1e7ef; border-radius: 6px; }
.clean-manage span { display: flex; gap: 14px; }

@media (max-width: 700px) {
  .clean-title { flex-direction: column; align-items: flex-start; }
  .clean-confirm { grid-auto-flow: row; }
}
